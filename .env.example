# Turso (libSQL) database — dedicated to this app, separate from the
# quint-ia-blueprint-funnel database. Local dev default (no Turso account needed):
TURSO_DATABASE_URL="file:./local.db"
# Only required for a hosted Turso database. Get both via the Turso dashboard or CLI
# (`turso db create`, `turso db show <name> --url`, `turso db tokens create <name>`).
TURSO_AUTH_TOKEN=

# Required for fast-pass email synthesis, the real Claude web_search visibility
# adapter, and both report syntheses. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ChatGPT and Perplexity engine adapters are MOCKED until these are set — see
# src/lib/engines/mock-adapter.ts. Not read by any code yet; reserved so the env file
# is ready when the real adapters are wired in (src/lib/fullpass/visibility.ts). These
# two are the engines that count toward visibility_score (Claude runs for real today
# but is a bonus signal, excluded from the score — see src/lib/types.ts).
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Domain Authority (referring-domain count) is MOCKED until one of these is set — see
# src/lib/fullpass/domainAuthority.ts. No provider chosen yet; whichever key you add,
# also wire a real DomainAuthorityProvider implementation and swap it in
# getDomainAuthorityProvider(). Not read by any code yet.
AHREFS_API_KEY=
MOZ_API_KEY=

# Email delivery (src/lib/email/provider.ts). Without this set, emails are logged to
# the console instead of sent — the pipeline still completes normally.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Where the internal owner report gets emailed. Defaults to team@quintiavantage.com
# if unset (see src/lib/fullpass/runFullPass.ts).
OWNER_REPORT_EMAIL=

# Optional — PageSpeed Insights works unauthenticated at a low quota. Set this for a
# higher quota. Get one at https://console.cloud.google.com (enable the PageSpeed
# Insights API, then create an API key).
PAGESPEED_API_KEY=

# Optional — off-site presence check (src/lib/fullpass/offsite.ts). Without this set,
# the YouTube channel/video check is skipped (logged, doesn't block the pipeline).
# Get one at https://console.cloud.google.com (enable the YouTube Data API v3).
YOUTUBE_API_KEY=

# Long-running full-pass queue (src/lib/queue/provider.ts). Without BOTH of these
# set, the app falls back to running the full pass in-process via Next's after() —
# fine for local dev, but doesn't solve the Vercel function-timeout risk a real full
# pass carries (~60 live LLM calls, can run minutes). Get these from
# https://console.upstash.com (create a QStash instance).
QSTASH_TOKEN=
# Public base URL QStash calls back to, e.g. https://your-app.vercel.app — required
# alongside QSTASH_TOKEN for QStashQueueProvider to activate.
QSTASH_CALLBACK_BASE_URL=
# For verifying that incoming /api/fullpass/run requests actually came from QStash.
# Same Upstash QStash dashboard as above. Without these set, signature verification
# is skipped (fine in local dev; required once QStash is actually in use).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Used to build the "full report" link inside the client-report email. Defaults to
# http://localhost:3000 if unset.
APP_BASE_URL=
